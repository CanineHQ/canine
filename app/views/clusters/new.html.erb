<%= content_for :title, t("scaffold.new.title", model: "Cluster") %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">
      <%= link_to "Clusters", clusters_path, class: "text-black dark:text-white" %>
      <span class="text-gray-400 font-light mx-2">\</span>
      <%= t("scaffold.new.title", model: "Cluster") %>
    </h1>
  </div>

  <%= render "shared/plan_limit_notice", resource: "cluster", plan_usage: @plan_usage %>

  <div class="card card-bordered bg-base-100 <%= 'opacity-50 pointer-events-none select-none' if @plan_usage && @plan_usage[:current] >= @plan_usage[:limit] %>">
    <div class="card-body">
      <%= render "form", cluster: @cluster %>
    </div>
  </div>
</div>
