<%= turbo_frame_tag @endpoint.metadata.name do %>
  <h2 class="text-lg font-bold mb-4">Edit domains for <u><%= @endpoint.metadata.name %></u></h2>

  <% if @errors.present? %>
    <div class="alert alert-error mb-4">
      <%= @errors.join(", ") %>
    </div>
  <% end %>

  <%= form_with(url: add_on_endpoint_path(@add_on, @endpoint.metadata.name), method: :patch) do |f| %>
    <% url = "#{@endpoint.metadata.name}.#{@add_on.name}.svc.cluster.local" %>
    <div class="form-control">
      <%= f.label :port, "Endpoint Port", class: "label" %>
      <div class="join w-full">
        <div class="w-full">
          <input class="input input-bordered w-full join-item" value="<%= url %>" disabled />
        </div>

        <%= f.select :port,
                    @endpoint.spec.ports.map { |p| [p.port, p.port] },
                    { selected: @endpoint.spec.ports.first.port },
                    class: "select select-bordered w-32" %>
      </div>
    </div>

    <div class="form-control">
      <%= f.label :domains, "Domains", class: "label" %>
      <%= f.text_field :domains, inputmode: "url", class: "input input-bordered" %>
      <p class="text-sm text-gray-500">Comma separated list of domains to use for this endpoint</p>
    </div>
    <div class="my-4 alert alert-warning">
      <% if @dns_record[:type] == :ip_address %>
        <span>Make sure to create an A Record to
        <code class="font-semibold cursor-pointer" data-controller="clipboard" data-clipboard-text="<%= @dns_record[:value] %>"><%= @dns_record[:value] %></code>
        for any domain you add here.</span>
      <% else %>
        <span>Make sure to create a CNAME Record to
        <code class="font-semibold cursor-pointer" data-controller="clipboard" data-clipboard-text="<%= @dns_record[:value] %>"><%= @dns_record[:value] %></code>
        for any domain you add here.</span>
      <% end %>
    </div>

    <div class="form-footer">
      <%= link_to "Cancel", edit_add_on_path(@add_on), class: "btn btn-secondary" %>
      <%= f.submit "Update", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="mt-4">
    <div class="form-control rounded-lg bg-base-200 p-2 px-4 max-w-md">
      <label class="label mt-1">
        <span class="label-text">Protect with Canine SSO</span>
      </label>
    </div>
    <span class="label-text-alt">Requires login through Canine before accessing this endpoint</span>
    <div class="form-footer">
      <% if @add_on.internal? %>
        <%= button_to "Disable SSO", add_on_oauth_application_path(@add_on), method: :delete, class: "btn btn-error btn-sm", data: { turbo_submits_with: "Disabling..." } %>
      <% else %>
        <%= button_to "Enable SSO", add_on_oauth_application_path(@add_on), method: :post, class: "btn btn-primary btn-sm", data: { turbo_submits_with: "Enabling..." } %>
      <% end %>
    </div>
  </div>
<% end %>
