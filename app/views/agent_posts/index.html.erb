<%= content_for :title, "#{@agent_computer.name} | Feed" %>

<%= agent_computer_layout(@agent_computer) do %>
  <div class="mb-4">
    <h6 class="text-sm font-semibold">Feed</h6>
    <p class="text-xs text-base-content/60">What this computer's agents did for you, newest first.</p>
  </div>

  <div class="mx-auto max-w-2xl">
    <% if @posts.empty? %>
      <div class="card card-bordered bg-base-100">
        <div class="card-body items-center text-center text-base-content/60">
          <iconify-icon icon="lucide:newspaper" height="32"></iconify-icon>
          <p>Nothing yet. After each run, what your agent did for you shows up here.</p>
        </div>
      </div>
    <% else %>
      <%= render "agent_posts/page", posts: @posts, more: @more, agent_computer: @agent_computer %>
    <% end %>
  </div>
<% end %>
