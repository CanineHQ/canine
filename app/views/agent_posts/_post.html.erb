<%# One post: its task (the header links to it) and computer and when, what the agent did, and a screenshot of the
    result. %>
<% kind = AgentPostsHelper::POST_KINDS[post.kind] %>
<article id="<%= dom_id(post) %>" class="border-b border-base-content/15 pb-5 mb-5 last:mb-0 last:border-b-0 last:pb-0">
  <div class="flex flex-col gap-4">
    <header class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-base-200 text-base-content/70">
        <iconify-icon icon="lucide:bot" height="16"></iconify-icon>
      </span>
      <div class="min-w-0 flex-1 leading-tight">
        <% if (task = post.session.agent_task) %>
          <%= link_to task.name, agent_computer_agent_task_path(post.agent_computer, task),
                class: "block truncate text-sm font-semibold hover:underline" %>
        <% else %>
          <div class="truncate text-sm font-semibold">Agent session</div>
        <% end %>
        <div class="truncate text-xs text-base-content/50">
          <%= post.agent_computer.name %> ·
          <time datetime="<%= post.posted_at.iso8601 %>" data-local="time-ago"><%= time_ago_in_words(post.posted_at) %> ago</time>
        </div>
      </div>
      <% if kind[:label] %>
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-base-200 px-2.5 py-1 text-xs font-medium <%= kind[:color] %>">
          <iconify-icon icon="<%= kind[:icon] %>"></iconify-icon><%= kind[:label] %>
        </span>
      <% end %>
    </header>

    <div class="flex items-start gap-4">
      <p class="min-w-0 flex-1 text-[15px] leading-relaxed text-base-content/90 break-words">
        <%= agent_post_body(post) %>
      </p>

      <% if (shot = post.screenshot) %>
        <button type="button" class="group relative block shrink-0 overflow-hidden rounded-lg border border-base-300" title="Open screenshot"
                data-action="lightbox#open" data-lightbox-id="<%= post.action.id %>"
                data-lightbox-url="<%= screenshots_agent_computer_agent_session_path(post.agent_computer, post.session) %>">
          <%= image_tag rails_representation_path(shot.variant(:medium)), loading: "lazy",
                class: "h-40 w-56 bg-base-200 object-cover object-top sm:w-72 lg:w-80", alt: "Screenshot after #{post.action.label}" %>
          <span class="absolute bottom-1 right-1 flex h-6 w-6 items-center justify-center rounded-md bg-base-100/80 text-base-content/80 opacity-0 transition group-hover:opacity-100">
            <iconify-icon icon="lucide:maximize-2" height="13"></iconify-icon>
          </span>
        </button>
      <% end %>
    </div>

    <footer class="flex items-center justify-between border-t border-base-300 pt-3">
      <% if (scheduled = post.session.agent_task)&.recurring? %>
        <%= link_to agent_computer_agent_task_path(post.agent_computer, scheduled),
              class: "inline-flex items-center gap-1 text-xs font-medium text-base-content/60 hover:text-base-content" do %>
          <iconify-icon icon="lucide:repeat" height="13"></iconify-icon> View scheduled task
        <% end %>
      <% else %>
        <span></span>
      <% end %>
      <%= link_to agent_computer_agent_session_path(post.agent_computer, post.session),
            class: "inline-flex items-center gap-1 text-xs font-medium text-base-content/60 hover:text-base-content" do %>
        View the whole run <iconify-icon icon="lucide:arrow-right" height="14"></iconify-icon>
      <% end %>
    </footer>
  </div>
</article>
