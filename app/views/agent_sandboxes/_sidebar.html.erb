<div class="tabs tabs-bordered mb-3" role="tablist">
  <%= link_to agent_sandbox_path(agent_sandbox), class: "tab hover:bg-base-content/15 #{'tab-active' if current_page?(agent_sandbox_path(agent_sandbox))}" do %>
    <div class="flex items-center gap-2">
      Overview
      <iconify-icon icon="lucide:layout-dashboard"></iconify-icon>
    </div>
  <% end %>
  <% if agent_sandbox.running? %>
    <%= link_to connect_agent_sandbox_path(agent_sandbox), class: "tab hover:bg-base-content/15 #{'tab-active' if current_page?(connect_agent_sandbox_path(agent_sandbox))}" do %>
      <div class="flex items-center gap-2">
        Desktop
        <iconify-icon icon="lucide:monitor"></iconify-icon>
      </div>
    <% end %>
  <% end %>
</div>
