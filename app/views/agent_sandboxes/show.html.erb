<%= agent_sandbox_layout(@agent_sandbox) do %>
  <div class="grid gap-4 md:grid-cols-3">
    <div>
      <div class="text-xs uppercase tracking-wide text-base-content/50">Status</div>
      <div class="mt-1"><%= agent_sandbox_status_badge(@agent_sandbox) %></div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-wide text-base-content/50">Cluster</div>
      <div class="mt-1 font-medium"><%= @agent_sandbox.cluster.name %></div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-wide text-base-content/50">Created</div>
      <div class="mt-1"><%= @agent_sandbox.created_at.strftime("%b %d, %Y at %I:%M %p") %></div>
    </div>
  </div>
<% end %>
