<%= content_for :title, "#{@agent_sandbox.name} | Connect" %>

<%= agent_sandbox_layout(@agent_sandbox) do %>
  <div class="w-full" style="height: 75vh;">
    <iframe
      src="<%= "/agent_sandboxes/#{@agent_sandbox.id}/proxy/" %>"
      class="w-full h-full border-0 rounded-lg"
      allow="clipboard-read; clipboard-write"
    ></iframe>
  </div>
<% end %>
