<%= project_layout(@project) do %>
  <div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div class="min-w-0 space-y-1">
        <h4 class="text-lg font-semibold break-words"><%= @error_issue.error_type || @error_issue.title %></h4>
        <% if @error_issue.error_type %>
          <p class="break-words text-base-content/80"><%= @error_issue.error_value %></p>
        <% end %>
        <p class="text-sm text-base-content/60">
          <span class="font-mono"><%= @error_issue.short_id %></span>
          · <%= @error_issue.level %>
          · <%= pluralize(number_with_delimiter(@error_issue.times_seen), "event") %>
          · first seen <%= time_ago_in_words(@error_issue.first_seen_at) %> ago
          · last seen <%= time_ago_in_words(@error_issue.last_seen_at) %> ago<%= " in #{@error_issue.last_release}" if @error_issue.last_release %>
        </p>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 shrink-0">
        <%= render "projects/error_issues/trend", buckets: @trend %>
        <div class="flex gap-2">
          <% if @error_issue.unresolved? %>
            <%= button_to "Resolve", project_error_issue_path(@project, @error_issue, status: "resolved"), method: :patch, class: "btn btn-sm btn-primary" %>
            <%= button_to "Ignore", project_error_issue_path(@project, @error_issue, status: "ignored"), method: :patch, class: "btn btn-sm btn-ghost" %>
          <% else %>
            <%= button_to "Unresolve", project_error_issue_path(@project, @error_issue, status: "unresolved"), method: :patch, class: "btn btn-sm btn-outline" %>
          <% end %>
          <%= button_to "Delete", project_error_issue_path(@project, @error_issue), method: :delete, class: "btn btn-sm btn-ghost text-error",
            form: { data: { turbo_confirm: "Delete this issue and all of its events?" } } %>
        </div>
      </div>
    </div>

    <% if @event.nil? %>
      <p class="text-base-content/60">No events are stored for this issue (events are pruned after <%= ErrorTracking::Event::RETENTION.inspect %>).</p>
    <% else %>
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-2 text-sm text-base-content/60">
          <span>
            Event <%= number_with_delimiter(@event_position) %> of <%= number_with_delimiter(@events_count) %> · <%= local_time_ago(@event.occurred_at) %>
          </span>
          <div class="flex items-center gap-1">
            <%= render "projects/error_issues/event_nav_button", label: "Newer event", target: @newer_event, icon: "lucide:chevron-left" %>
            <%= render "projects/error_issues/event_nav_button", label: "Older event", target: @older_event, icon: "lucide:chevron-right" %>
          </div>
        </div>
        <%= render "projects/error_issues/event", event: @event, full_stack: @full_stack %>
      </div>
    <% end %>
  </div>
<% end %>
