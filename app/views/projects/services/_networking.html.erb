<div>
  <div class="mb-6 space-y-2">
    <h2 class="text-xl font-bold">Internal URL</h2>
    <hr class="mt-3 mb-4 border-t border-base-300" />
    <pre
      class="inline-block cursor-pointer"
      data-controller="clipboard"
      data-clipboard-text="<%= service.internal_url %>"><%= service.internal_url %></pre>

    <%= render "projects/services/telepresence_guide", cluster: @project.cluster, url: "http://#{service.internal_url}" %>
  </div>
  <% if service.allow_public_networking? %>
    <div>
      <h2 class="text-xl font-bold">Public Networking</h2>
      <hr class="mt-3 mb-4 border-t border-base-300" />
      <div class="form-control form-group">
        <%= render "projects/services/domains/index", service: service %>
      </div>
    </div>

    <div class="mt-6">
      <h4 class="text-lg font-bold mb-2">Canine SSO</h4>
      <p class="text-sm text-gray-500 mb-4">Protect this service with Canine Single Sign-On. When enabled, users must authenticate through Canine before they can access this service. An OAuth2 proxy is deployed alongside your service to handle authentication automatically.</p>
      <% if service.internal? %>
        <div class="flex items-center gap-3">
          <span class="badge badge-success gap-1"><iconify-icon icon="lucide:shield-check" height="12"></iconify-icon> SSO Enabled</span>
          <%= button_to "Disable SSO", project_service_oauth_application_path(service.project, service), method: :delete, class: "btn btn-error btn-sm", data: { turbo_submits_with: "Disabling...", turbo_confirm: "Are you sure you want to disable SSO protection?" } %>
        </div>
      <% else %>
        <%= button_to "Enable SSO", project_service_oauth_application_path(service.project, service), method: :post, class: "btn btn-primary btn-sm", data: { turbo_submits_with: "Enabling..." } %>
      <% end %>
    </div>
  <% end %>
</div>