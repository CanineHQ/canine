<% service_domains = project.services.flat_map { |s| s.domains.map { |d| [d.domain_name, s.internal?] } } %>
<% if service_domains.any? %>
  <div class="my-3 flex items-center gap-3 flex-wrap">
    <% service_domains.each do |url, internal| %>
      <span>
        <%= link_to "https://#{url}", target: "_blank", class: "text-sm text-ellipsis" do %>
          <%= url %>
          <% if internal %>
            <iconify-icon icon="lucide:shield-check" class="text-xs"></iconify-icon>
          <% else %>
            <iconify-icon icon="lucide:external-link" class="text-xs"></iconify-icon>
          <% end %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>
