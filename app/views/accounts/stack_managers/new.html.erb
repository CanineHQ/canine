<%= settings_layout do %>
  <h2 class="text-2xl font-bold">Stack Manager</h2>
  <p class="text-sm text-base-content/60 mt-1">Stack Manager allows Canine to connect to your clusters through enterprise platforms like Rancher or Portainer.</p>
  <hr class="mt-3 mb-4 border-t border-base-300" />
  
  <%= turbo_frame_tag "current_account_stack_manager" do %>
    <div class="card card-bordered bg-base-100">
      <div class="card-body">
        <h3 class="card-title">Configure Stack Manager</h3>
        
        <%= render 'form', stack_manager: @stack_manager, account: current_account %>
      </div>
    </div>
  <% end %>
<% end %>