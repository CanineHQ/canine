<%= form_with model: [@agent_computer, task], scope: :agent_task, url: task.persisted? ? agent_computer_agent_task_path(@agent_computer, task) : agent_computer_agent_tasks_path(@agent_computer) do |form| %>
  <%= render "shared/error_messages", resource: task %>
  <div class="space-y-8">
    <%= render(FormFieldComponent.new(label: "What should the agent do?", description: "In your own words, including how often. \"Draft\" turns it into the details below, which you can review and change.")) do %>
      <%= form.text_area :instruction, rows: 3, class: "textarea textarea-bordered w-full", required: true,
        placeholder: "Every hour, check Slack and email for feature requests to my app, and if they look straightforward enough, implement them." %>
      <% unless task.persisted? %>
        <%= form.button "Draft from this", formaction: draft_agent_computer_agent_tasks_path(@agent_computer), class: "btn btn-secondary btn-sm mt-2",
          data: { turbo_submits_with: "Drafting…" } %>
      <% end %>
    <% end %>

    <%= render(FormFieldComponent.new(label: "Name")) do %>
      <%= form.text_field :name, class: "input input-bordered w-full" %>
    <% end %>

    <%= render(FormFieldComponent.new(label: "Schedule", description: "Cron, in the server's time zone: \"0 * * * *\" is hourly; \"0 9-18 * * 1-5\" is hourly, 9 to 6, on weekdays.")) do %>
      <%= form.text_field :schedule, class: "input input-bordered w-full font-mono" %>
    <% end %>

    <%= render(FormFieldComponent.new(label: "Model", description: "Any OpenRouter model id that supports tools and images.")) do %>
      <%= form.text_field :model, class: "input input-bordered w-full font-mono" %>
    <% end %>

    <%= render(FormFieldComponent.new(label: "Time zone", description: "Yours: the agent reads \"today\" and run times in it, and next runs are shown in it.")) do %>
      <%= form.select :time_zone, ActiveSupport::TimeZone.all.map { |zone| [ zone.to_s, zone.tzinfo.name ] }.uniq(&:last),
            { include_blank: "Not set (the computer's clock is UTC)" }, class: "select select-bordered w-full" %>
    <% end %>

    <%= render(FormFieldComponent.new(label: "Workspace", description: "Where its windows open on the computer, without switching your screen to it. A free one is picked for each run if you leave it: one you're not on, with nothing of yours on it. Everything on it is closed before and after each run.")) do %>
      <%= form.select :pinned_workspace, (1..10).to_a, { include_blank: "Any free one" }, class: "select select-bordered w-full" %>
    <% end %>

    <%= render(FormFieldComponent.new(label: "Limits per run", description: "Canine stops a run at whichever it reaches first, warning the agent to wrap up at 75%.")) do %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <label class="form-control">
          <span class="label-text text-xs mb-1">Minutes</span>
          <%= form.number_field :max_minutes, min: 1, step: 1, class: "input input-bordered w-full" %>
        </label>
        <label class="form-control">
          <span class="label-text text-xs mb-1">Cost (USD)</span>
          <%= form.number_field :max_cost_usd, min: 0.01, step: 0.01, class: "input input-bordered w-full" %>
        </label>
        <label class="form-control">
          <span class="label-text text-xs mb-1">Turns</span>
          <%= form.number_field :max_turns, min: 1, step: 1, class: "input input-bordered w-full" %>
        </label>
      </div>
    <% end %>

    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :enabled, class: "checkbox checkbox-sm" %>
      Enabled: run on the schedule
    </label>
  </div>

  <div class="form-footer">
    <%= form.button "Save Task", class: "btn btn-primary" %>
    <% if local_assigns[:in_modal] %>
      <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
    <% else %>
      <%= link_to "Cancel", agent_computer_agent_tasks_path(@agent_computer), class: "btn btn-secondary" %>
    <% end %>
  </div>
<% end %>
