<%# A comment, laid out like a post's header (photo, name, when) with its text underneath, and under it the follow-up
    run acting on it the same way: its progress, then its summary as the reply %>
<% run = comment.session %>
<% user = comment.user %>
<% at = ->(time) { time > 1.day.ago ? "#{time_ago_in_words(time)} ago" : time.strftime("%B %-d at %-l:%M %p") } %>
<div id="<%= dom_id(comment) %>" class="space-y-3">
  <div>
    <div class="flex items-center gap-2.5">
      <div class="avatar shrink-0">
        <div class="h-9 w-9 rounded-full ring-2 ring-primary ring-offset-2 ring-offset-base-100">
          <%= image_tag avatar_path(user, size: 72), alt: "" %>
        </div>
      </div>
      <div class="min-w-0 leading-tight">
        <div class="truncate text-sm font-semibold"><%= user.first_name.present? ? "#{user.first_name} #{user.last_name}".strip : user.email %></div>
        <time class="text-xs text-base-content/50" datetime="<%= comment.created_at.iso8601 %>"><%= at.(comment.created_at) %></time>
      </div>
    </div>
    <p class="mt-2 whitespace-pre-wrap break-words text-[15px] leading-relaxed"><%= comment.body %></p>
  </div>

  <% if run %>
    <div class="ml-6 border-l-2 border-base-content/10 pl-4">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-base-200 text-base-content/70">
          <iconify-icon icon="lucide:bot" height="16"></iconify-icon>
        </span>
        <div class="min-w-0 flex-1 leading-tight">
          <div class="truncate text-sm font-semibold"><%= run.task.name %></div>
          <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-base-content/50">
            <time datetime="<%= (run.finished_at || run.created_at).iso8601 %>"><%= at.(run.finished_at || run.created_at) %></time>
            <span>·</span>
            <%= render "agent_computers/sessions/status_badge", session: run %>
            <span>·</span>
            <%= link_to "View run", agent_computer_agent_session_path(comment.post.agent_computer, run), class: "whitespace-nowrap hover:text-base-content hover:underline" %>
          </div>
        </div>
      </div>
      <% if run.summary.present? %>
        <div class="prose prose-sm mt-2 max-w-none text-[15px] prose-p:my-1 prose-ul:my-1 prose-li:my-0.5 prose-a:text-base-content"><%= agent_markdown(run.summary) %></div>
      <% elsif run.error.present? %>
        <p class="mt-2 text-sm text-error"><%= run.error %></p>
      <% else %>
        <p class="mt-2 text-sm text-base-content/60">On it…</p>
      <% end %>
    </div>
  <% end %>
</div>
