<%= content_for :title, "Agent Computers" %>

<div>
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-medium">Agent Computers</h3>
  </div>

  <% if current_account.agent_computers.none? %>
    <%= render "agent_computers/intro" %>
  <% else %>
    <div class="mt-5">
      <div aria-label="Card" class="card card-bordered bg-base-100">
        <div class="card-body">
          <div class="flex justify-end gap-2 px-5 pt-5">
            <%= link_to agent_provider_keys_path, class: "btn btn-ghost btn-sm" do %>
              <iconify-icon icon="lucide:key-round" height="16"></iconify-icon>
              <span class="hidden sm:inline">Agent settings</span>
            <% end %>
            <%= link_to new_agent_computer_path, class: "btn btn-primary btn-sm", title: "New Computer" do %>
              <iconify-icon icon="lucide:plus" height="16"></iconify-icon>
              <span class="hidden sm:inline">New Computer</span>
            <% end %>
          </div>

          <div class="overflow-auto">
            <table class="table mt-2 rounded-box" data-component="table">
              <thead>
                <tr>
                  <th><span class="text-sm font-medium text-base-content/80">Name</span></th>
                  <th><span class="text-sm font-medium text-base-content/80">Status</span></th>
                  <th><span class="text-sm font-medium text-base-content/80">Cluster Name</span></th>
                  <th><span class="text-sm font-medium text-base-content/80">Created By</span></th>
                  <th><span class="text-sm font-medium text-base-content/80">Created</span></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @agent_computers.each do |computer| %>
                  <tr class="hover:bg-base-200/40" id="<%= dom_id(computer, :index) %>">
                    <td>
                      <div class="font-medium"><%= link_to computer.name, agent_computer_path(computer), class: "text-inherit hover:underline" %></div>
                    </td>
                    <td><%= agent_computer_status_badge(computer) %></td>
                    <td><%= computer.cluster.name %></td>
                    <td><%= computer.user.first_name.present? ? "#{computer.user.first_name} #{computer.user.last_name}".strip : computer.user.email %></td>
                    <td>
                      <div role="tooltip" data-tip="<%= computer.created_at.strftime("%B %d, %Y %I:%M %p") %>" class="tooltip">
                        <div class="text-sm"><%= time_ago(computer.created_at) %></div>
                      </div>
                    </td>
                    <td>
                      <div class="inline-flex w-fit gap-1">
                        <% if computer.running? %>
                          <%= link_to connect_agent_computer_path(computer), aria: { label: "Open desktop" }, class: "btn btn-square btn-ghost btn-sm", title: "Open desktop" do %>
                            <iconify-icon icon="lucide:monitor" height="15" class="text-base-content/70"></iconify-icon>
                          <% end %>
                        <% end %>
                        <%= link_to edit_agent_computer_path(computer), aria: { label: "Machine settings" }, class: "btn btn-square btn-ghost btn-sm", title: "Machine settings" do %>
                          <iconify-icon icon="lucide:pencil" height="15" class="text-base-content/70"></iconify-icon>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
