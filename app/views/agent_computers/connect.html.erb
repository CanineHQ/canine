<%= content_for :title, "#{@agent_computer.name} | Desktop" %>
<% if @agent_computer.desktop == "vnc" %>
  <div class="relative h-screen w-screen bg-black"
       data-controller="vnc-viewer" data-vnc-viewer-url-value="<%= "/agent_computers/#{@agent_computer.id}/vnc" %>">
    <div data-vnc-viewer-target="screen" class="absolute inset-0"></div>
    <div data-vnc-viewer-target="status" hidden
         class="absolute top-3 left-1/2 -translate-x-1/2 z-10 alert alert-warning shadow-lg w-auto py-2 text-sm">
      Connecting...
    </div>
  </div>
<% else %>
<% watching = params[:watch].present? %>

<div class="relative h-screen w-screen bg-base-300"
     data-controller="computer-desktop"
     data-computer-desktop-url-value="<%= "/agent_computers/#{@agent_computer.id}/proxy/" %>"
     data-computer-desktop-watch-value="<%= watching %>">
  <iframe
    data-computer-desktop-target="frame"
    class="absolute inset-0 w-full h-full border-0"
    allow="clipboard-read; clipboard-write; autoplay; fullscreen; keyboard-map"
  ></iframe>

  <%# Only shown while the connection is down, so the desktop gets the whole window %>
  <div data-computer-desktop-target="status" class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-10 alert alert-warning shadow-lg w-auto py-2 text-sm">
    <span class="loading loading-spinner loading-xs"></span>
    <span data-computer-desktop-target="statusText">Reconnecting...</span>
    <button type="button" data-action="computer-desktop#reconnect" class="btn btn-ghost btn-xs">Retry now</button>
    <%= link_to "Back to #{@agent_computer.name}", agent_computer_path(@agent_computer), class: "btn btn-ghost btn-xs" %>
  </div>

  <%# Another tab took control of this desktop (Selkies allows one controlling tab) %>
  <div data-computer-desktop-target="replaced" class="hidden absolute inset-0 z-20 flex items-center justify-center bg-base-300/80">
    <div class="card bg-base-100 shadow-xl w-96">
      <div class="card-body items-center text-center">
        <iconify-icon icon="lucide:monitor-off" height="32"></iconify-icon>
        <h2 class="card-title">Opened in another tab</h2>
        <p class="text-sm text-base-content/70">A desktop can be controlled from one tab at a time. Take it back here, or keep watching without controlling it.</p>
        <div class="card-actions mt-2">
          <button type="button" data-action="computer-desktop#takeOver" class="btn btn-primary btn-sm">Take over here</button>
          <%= link_to "Watch instead", connect_agent_computer_path(@agent_computer, watch: 1), class: "btn btn-ghost btn-sm" %>
        </div>
      </div>
    </div>
  </div>

  <% if watching %>
    <div class="absolute bottom-3 right-3 z-10 flex items-center gap-2 rounded-full bg-base-100/80 px-3 py-1 text-xs shadow">
      <iconify-icon icon="lucide:eye"></iconify-icon>
      Watching (view only)
      <%= link_to "Take control", connect_agent_computer_path(@agent_computer), class: "link link-primary" %>
    </div>
  <% end %>
</div>
<% end %>
