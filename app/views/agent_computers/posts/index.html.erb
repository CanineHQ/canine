<%= content_for :title, "#{@agent_computer.name} | Feed" %>

<%= agent_computer_layout(@agent_computer) do %>
  <div class="flex gap-6" data-controller="agent-computers--lightbox" data-action="keydown@window->agent-computers--lightbox#keydown">
    <div class="min-w-0 flex-1 lg:border-r lg:border-base-content/15 lg:pr-6">
      <%= turbo_stream_from [ @agent_computer, :feed ] %>
      <%= render "agent_computers/posts/compose" %>

      <%# Active runs stream in here (newest first) and drop out when they finish. %>
      <div id="agent_feed_active">
        <% @active.each do |session| %>
          <%= render "agent_computers/posts/running", session: session %>
        <% end %>
      </div>

      <%# Finished runs' posts. New ones prepend here live. %>
      <div id="agent_feed_posts">
        <% unless @posts.empty? %>
          <%= render "agent_computers/posts/page", posts: @posts, more: @more, agent_computer: @agent_computer %>
        <% end %>
      </div>

      <% if @posts.empty? && @active.empty? %>
        <div class="card border border-base-content/20 bg-base-100">
          <div class="card-body items-center text-center text-base-content/60">
            <iconify-icon icon="lucide:newspaper" height="32"></iconify-icon>
            <p><%= openrouter_key? ? "Nothing yet. Describe a task above — what your agent does for you shows up here." : "Nothing yet. Once there's a key, what your agent does for you shows up here." %></p>
          </div>
        </div>
      <% end %>
    </div>

    <aside class="hidden lg:block w-96 shrink-0">
      <div class="lg:sticky lg:top-4">
        <%= render "agent_computers/posts/scheduled", tasks: @scheduled %>
      </div>
    </aside>

    <%= render "agent_computers/sessions/lightbox_overlay" %>
  </div>
<% end %>
