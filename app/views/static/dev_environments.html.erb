<% content_for :title, "Dev Environments — Cloud Development Environments on Kubernetes | Canine" %>
<% content_for :meta_description, "Spin up instant cloud dev environments on your Kubernetes cluster. Get a browser-based terminal, file uploads, and your full repo — ready in seconds." %>
<% content_for :og_title, "Canine Dev Environments — Cloud Development Environments on Kubernetes" %>
<% content_for :og_description, "Spin up instant cloud dev environments on your Kubernetes cluster. Get a browser-based terminal, file uploads, and your full repo — ready in seconds." %>
<% content_for :schema_json do %>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://canine.sh/dev-environments#webpage",
      "url": "https://canine.sh/dev-environments",
      "name": "Canine Dev Environments",
      "description": "Cloud development environments on Kubernetes. Browser-based terminal, file uploads, and your full repo — ready in seconds.",
      "isPartOf": { "@id": "https://canine.sh/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://canine.sh/dev-environments#software",
      "name": "Canine Dev Environments",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "description": "Instant cloud development environments with browser-based terminal access to Kubernetes pods.",
      "url": "https://canine.sh/dev-environments",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }
  ]
}
<% end %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script>
  ["DOMContentLoaded"].forEach(function(e) {
    document.addEventListener(e, function() { AOS.init({ once: true, duration: 300, offset: 80, easing: "ease-out-cubic" }); });
  });
</script>

<div class="bg-gray-900 min-h-screen">
  <%= render "static/landing_page/navbar" %>

  <main>
    <!-- Hero -->
    <div class="relative isolate">
      <div class="absolute inset-x-0 top-10 -z-10 flex transform-gpu justify-center overflow-hidden blur-3xl" aria-hidden="true">
        <div class="aspect-[1108/632] w-[69.25rem] flex-none bg-gradient-to-r from-[#8b5cf6] to-[#6366f1] opacity-20" style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
          <div class="inline-flex items-center gap-2 rounded-full bg-violet-500/10 px-4 py-1.5 text-sm font-medium text-violet-400 ring-1 ring-violet-500/20 mb-8">
            <iconify-icon icon="lucide:terminal" class="text-base"></iconify-icon>
            Cloud Dev Environments
          </div>
          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
            Your dev environment, in the cloud
          </h1>
          <p class="mt-6 text-lg leading-8 text-gray-300 max-w-2xl mx-auto">
            Spin up a cloud dev environment and let AI agents build for you. Bring your own Claude Code, Cursor, or Codex API key &mdash; Canine gives them a full environment to code, test, and preview in.
          </p>
          <div class="mt-10 flex items-center justify-center gap-x-6">
            <a href="<%= new_user_registration_path %>" class="rounded-md bg-violet-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-400 transition">
              Get Started
            </a>
            <a href="https://docs.canine.sh" class="text-sm font-semibold text-white hover:text-violet-400 transition">
              Read the docs <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Workbench Preview -->
    <%= render "static/dev_environments/workbench_preview" %>

    <!-- How it works -->
    <div id="how-it-works" class="bg-gray-800/30 py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center mb-16" data-aos="fade-up">
        <h2 class="text-base font-semibold leading-7 text-violet-400"><a href="#how-it-works" class="hover:underline underline-offset-4">How it works</a></h2>
        <p class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-4xl">From zero to terminal in seconds</p>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="relative rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8" data-aos="fade-up" data-aos-delay="0">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-500/10 text-violet-400 text-xl font-bold mb-6">1</div>
          <h3 class="text-lg font-semibold text-white mb-2">Enable dev environments</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Point Canine at your Dockerfile and choose a cluster. Your dev environment configuration is saved to the project.</p>
        </div>
        <div class="relative rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8" data-aos="fade-up" data-aos-delay="100">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-500/10 text-violet-400 text-xl font-bold mb-6">2</div>
          <h3 class="text-lg font-semibold text-white mb-2">Canine builds and deploys</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Your image is built, a pod is spun up on your cluster, and your repository is cloned into the workspace automatically.</p>
        </div>
        <div class="relative rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8" data-aos="fade-up" data-aos-delay="200">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-500/10 text-violet-400 text-xl font-bold mb-6">3</div>
          <h3 class="text-lg font-semibold text-white mb-2">Start coding</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Open the browser terminal and you're in. Run commands, debug live, drag and drop files &mdash; all from the Canine UI.</p>
        </div>
      </div>
    </div>
    </div>

    <!-- Features -->
    <div id="features" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-16" data-aos="fade-up">
        <h2 class="text-base font-semibold leading-7 text-violet-400"><a href="#features" class="hover:underline underline-offset-4">Features</a></h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Everything you need to develop</p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:sparkles" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Built for AI coding</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Give Claude Code, Cursor, or any AI agent a cloud environment to build and test in. No local setup, no "works on my machine."</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:globe" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Shareable preview URLs</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Every dev environment gets a public URL. Share it with teammates, designers, or stakeholders to preview changes live.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:terminal" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Browser-based terminal</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Full xterm.js terminal in your browser. No SSH keys, no VPN, no local setup required.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:git-branch" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Auto-cloned repo</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Your repository is automatically cloned into the workspace. Start coding the moment you connect.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:container" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Your own Dockerfile</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Bring your own Dockerfile so every tool, runtime, and dependency is exactly how you want it.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:refresh-cw" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Sync local files to pod</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Use the Canine CLI to sync your local codebase to the pod. Watch mode auto-syncs on every save.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:upload-cloud" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Drag &amp; drop file uploads</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Drop files directly into the terminal. They land in your pod instantly, ready to use.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:users" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Multi-session support</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Up to 5 concurrent terminal sessions per user. Run your server in one, tests in another.</p>
        </div>

        <div class="rounded-2xl bg-gray-800/50 ring-1 ring-white/10 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 mb-4">
            <iconify-icon icon="lucide:laptop" class="text-violet-400 text-lg"></iconify-icon>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Connect from your terminal</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Prefer your own terminal? Connect via the Canine CLI or kubectl &mdash; your choice.</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="relative isolate mt-16 px-6 py-32 sm:mt-32 sm:py-40 lg:px-8">
      <svg class="absolute inset-0 -z-10 h-full w-full stroke-white/10 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
        <defs>
          <pattern id="dev-env-cta-grid" width="200" height="200" x="50%" y="0" patternUnits="userSpaceOnUse">
            <path d="M.5 200V.5H200" fill="none"></path>
          </pattern>
        </defs>
        <svg x="50%" y="0" class="overflow-visible fill-gray-800/20">
          <path d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z" stroke-width="0"></path>
        </svg>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#dev-env-cta-grid)"></rect>
      </svg>
      <div class="absolute inset-x-0 top-10 -z-10 flex transform-gpu justify-center overflow-hidden blur-3xl" aria-hidden="true">
        <div class="aspect-[1108/632] w-[69.25rem] flex-none bg-gradient-to-r from-[#8b5cf6] to-[#6366f1] opacity-20" style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"></div>
      </div>
      <div class="mx-auto max-w-2xl text-center" data-aos="fade-up">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Start developing in the cloud</h2>
        <p class="mx-auto mt-6 text-lg leading-8 text-gray-300">
          Sign up for Canine Cloud and launch your first dev environment in under 5 minutes. No credit card required.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a href="<%= new_user_registration_path %>" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition">
            Get Started Free
          </a>
        </div>
      </div>
    </div>
  </main>

  <%= render "static/landing_page/footer" %>
</div>
