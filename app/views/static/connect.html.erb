<% page_url = "#{request.base_url}/connect" %>
<% content_for :title, "Canine Connect — Your Kubernetes Cluster's Private Network on Your Mac" %>
<% content_for :meta_description, "Canine Connect is a free macOS menu bar app that puts your Mac on your Kubernetes cluster's private network. Reach databases, caches and internal services at their cluster addresses, with no port-forwarding." %>
<% content_for :og_title, "Canine Connect — Your cluster's private network, one switch away" %>
<% content_for :og_description, "A free macOS menu bar app that puts your Mac on your Kubernetes cluster's private network. No port-forwarding, nothing exposed to the internet." %>
<% content_for :og_url, page_url %>
<% content_for :og_image, "#{request.base_url}/images/canine_connect/connected.png" %>
<% content_for :schema_json do %>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Canine Connect",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "macOS 13 or later",
  "description": "A macOS menu bar app that puts your Mac on a Kubernetes cluster's private network.",
  "url": "<%= page_url %>",
  "downloadUrl": "<%= CanineConnectRelease.download_url("arm64") %>",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
<% end %>
<% install_command = CanineConnectRelease.install_command("arm64") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script>
  ["DOMContentLoaded"].forEach(function(e) {
    document.addEventListener(e, function() { AOS.init({ once: true, duration: 300, offset: 80, easing: "ease-out-cubic" }); });
  });
</script>

<div class="bg-gray-900 min-h-screen">
  <%= render "static/landing_page/navbar" %>

  <main>
    <!-- Hero -->
    <div class="relative isolate">
      <div class="absolute inset-x-0 top-10 -z-10 flex transform-gpu justify-center overflow-hidden blur-3xl" aria-hidden="true">
        <div class="aspect-[1108/632] w-[69.25rem] flex-none bg-gradient-to-r from-[#34d399] to-[#22d3ee] opacity-20"></div>
      </div>

      <div class="mx-auto grid max-w-7xl items-center gap-16 px-6 py-20 sm:py-28 lg:grid-cols-5 lg:px-8">
        <div class="min-w-0 lg:col-span-3" data-aos="fade-up">
          <div class="mb-8 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-400 ring-1 ring-emerald-500/20">
            <iconify-icon icon="mdi:apple" class="text-base"></iconify-icon>
            Canine Connect for macOS
          </div>
          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
            Your cluster's private network, one switch away
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-300">
            Canine Connect puts your Mac on your Kubernetes cluster's private network. Databases, caches and internal
            services answer at their cluster addresses, with no port-forwarding and nothing exposed to the internet.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <%= link_to CanineConnectRelease.download_url("arm64"), class: "inline-flex items-center gap-2 rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-sm transition hover:bg-gray-100" do %>
              <iconify-icon icon="mdi:apple" height="18"></iconify-icon>
              Download for Apple Silicon
            <% end %>
            <%= link_to "Intel Mac", CanineConnectRelease.download_url("x86_64"), class: "rounded-md px-4 py-2.5 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/10" %>
            <%= link_to CanineConnectRelease.repository_url, target: "_blank", rel: "noopener", class: "text-sm font-semibold text-white transition hover:text-emerald-400" do %>
              Source on GitHub <span aria-hidden="true">→</span>
            <% end %>
          </div>
          <p class="mt-4 text-sm text-gray-400">
            Free and open source. Requires macOS 13 Ventura or later. Includes Telepresence <%= CanineConnectRelease.telepresence_version %>.
          </p>

          <div class="mt-8 max-w-2xl cursor-pointer overflow-hidden rounded-xl ring-1 ring-white/10" data-controller="clipboard" data-clipboard-text="<%= install_command %>">
            <div class="border-b border-white/10 bg-gray-900 px-4 py-2 text-xs text-gray-400">Or install from Terminal (Apple Silicon). Click to copy.</div>
            <pre class="overflow-x-auto bg-gray-950 px-4 py-3 font-mono text-xs leading-relaxed text-gray-100"><code><span class="text-emerald-400">$</span> <%= install_command %></code></pre>
          </div>
        </div>

        <div class="flex justify-center lg:col-span-2" data-aos="fade-up" data-aos-delay="150">
          <%= image_tag "/images/canine_connect/connected.png",
                alt: "Canine Connect in the macOS menu bar, connected to a cluster called production",
                class: "w-full max-w-[340px] rounded-2xl shadow-2xl ring-1 ring-white/10" %>
        </div>
      </div>
    </div>

    <!-- How it works -->
    <div id="how-it-works" class="bg-gray-800/30 py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-2xl text-center" data-aos="fade-up">
          <h2 class="text-base font-semibold leading-7 text-emerald-400"><a href="#how-it-works" class="underline-offset-4 hover:underline">How it works</a></h2>
          <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Three steps, about a minute</p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          <% [
            [ "Sign in with your Canine", "Click the dog in your menu bar and approve the app in your browser. No tokens to copy, no kubeconfig files to download." ],
            [ "Pick a cluster and flip the switch", "The first time, macOS asks for your password so the network tunnel can be set up. After that it is one click." ],
            [ "Use cluster addresses anywhere", "Your browser, psql, redis-cli and your own code all reach services at the same address they have inside the cluster." ]
          ].each_with_index do |(title, body), index| %>
            <div class="rounded-2xl bg-white/5 p-8 ring-1 ring-white/10" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400"><%= index + 1 %></div>
              <h3 class="mt-5 text-lg font-semibold text-white"><%= title %></h3>
              <p class="mt-2 text-sm leading-6 text-gray-300"><%= body %></p>
            </div>
          <% end %>
        </div>
        <div class="mx-auto mt-10 max-w-2xl overflow-hidden rounded-xl ring-1 ring-white/10" data-aos="fade-up">
          <pre class="overflow-x-auto bg-gray-950 px-6 py-4 font-mono text-sm leading-relaxed text-gray-100"><code><span class="text-gray-400"># With the switch on, from your Mac</span>
<span class="text-emerald-400">$</span> psql -h postgres.my-app.svc.cluster.local -U app
<span class="text-emerald-400">$</span> curl http://web.my-app.svc.cluster.local:3000/up</code></pre>
        </div>
      </div>
    </div>

    <!-- Why -->
    <div id="why" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center" data-aos="fade-up">
        <h2 class="text-base font-semibold leading-7 text-emerald-400"><a href="#why" class="underline-offset-4 hover:underline">Why Canine Connect</a></h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Private stays private</p>
      </div>
      <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        <% [
          [ "lucide:shield-check", "Nothing exposed", "Your database never gets a public address or an open port. The tunnel goes through the Kubernetes API you already trust." ],
          [ "lucide:cable", "No port-forwarding", "No terminal tab to keep open per service and no local ports to remember. Every service in the cluster is reachable at once." ],
          [ "lucide:key-round", "No credentials to manage", "Sign in with your Canine account. The app fetches short-lived cluster credentials for you each time you connect." ],
          [ "lucide:layers", "All your clusters", "Switch between clusters from the menu bar, like changing location in a VPN app." ],
          [ "lucide:server", "Works with your own Canine", "Canine Cloud or self-hosted: the app signs in to whichever Canine you point it at." ],
          [ "lucide:git-fork", "Open source", "Built on Telepresence, with the source on GitHub. On Linux or Windows, use the Telepresence CLI the same way." ]
        ].each_with_index do |(icon, title, body), index| %>
          <div data-aos="fade-up" data-aos-delay="<%= (index % 3) * 100 %>">
            <iconify-icon icon="<%= icon %>" class="text-2xl text-emerald-400"></iconify-icon>
            <h3 class="mt-4 text-base font-semibold text-white"><%= title %></h3>
            <p class="mt-2 text-sm leading-6 text-gray-300"><%= body %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Self-hosted -->
    <div id="self-hosted" class="bg-gray-800/30 py-24">
      <div class="mx-auto max-w-3xl px-6 text-center lg:px-8" data-aos="fade-up">
        <h2 class="text-base font-semibold leading-7 text-emerald-400"><a href="#self-hosted" class="underline-offset-4 hover:underline">Self-hosted</a></h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Running your own Canine?</p>
        <p class="mt-6 text-lg leading-8 text-gray-300">
          Canine Connect is not tied to any one address. Open <span class="font-semibold text-white">Canine Connect for Mac</span>
          from the menu in your own Canine and click <span class="font-semibold text-white">Open in Canine Connect</span>:
          the app is handed your Canine's address, so there is nothing to type. Your clusters need the Telepresence
          package, which Canine installs by default.
        </p>
        <div class="mt-8 flex items-center justify-center gap-x-6">
          <a href="/self-hosted" data-turbo="false" class="rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-sm transition hover:bg-gray-100">Self-host Canine</a>
          <%= link_to new_user_session_path, class: "text-sm font-semibold text-white transition hover:text-emerald-400" do %>
            Sign in to this Canine <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
      <div class="relative rounded-2xl bg-gray-800/50 px-8 py-16 text-center ring-1 ring-white/10 sm:px-16" data-aos="fade-up">
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Stop port-forwarding</h2>
        <p class="mx-auto mt-4 max-w-xl text-gray-400">Download Canine Connect and reach everything in your cluster from your Mac.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <%= link_to CanineConnectRelease.download_url("arm64"), class: "inline-flex items-center gap-2 rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-sm transition hover:bg-gray-100" do %>
            <iconify-icon icon="mdi:apple" height="18"></iconify-icon>
            Download for Apple Silicon
          <% end %>
          <%= link_to "Intel Mac", CanineConnectRelease.download_url("x86_64"), class: "rounded-md px-4 py-2.5 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/10" %>
        </div>
      </div>
    </div>
  </main>

  <%= render "static/landing_page/footer" %>
</div>
