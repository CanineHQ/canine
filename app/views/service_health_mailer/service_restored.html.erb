<h2>Service Restored: <%= @service.name %></h2>

<p>The service <strong><%= @service.name %></strong> in project <strong><%= @project.name %></strong> is healthy again.</p>

<p>
  <strong>Service:</strong> <%= @service.name %><br>
  <strong>Project:</strong> <%= @project.name %><br>
  <strong>Checked at:</strong> <%= @service.last_health_checked_at&.strftime("%Y-%m-%d %H:%M:%S UTC") %>
</p>

<p><%= link_to "View Service", project_service_url(@project, @service) %></p>
