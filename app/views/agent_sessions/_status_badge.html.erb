<% colors = { "queued" => "badge-ghost", "running" => "badge-info", "waiting_for_human" => "badge-warning", "waiting_for_tool" => "badge-info",
              "succeeded" => "badge-success", "failed" => "badge-error", "cancelled" => "badge-ghost" } %>
<span class="badge badge-sm <%= colors[session.status] %> gap-1">
  <% if session.running? || session.waiting_for_tool? %><span class="loading loading-spinner loading-xs"></span><% end %>
  <%= { "waiting_for_human" => "paused: you're using the computer", "waiting_for_tool" => "coding agent working" }[session.status] || session.status %>
</span>
