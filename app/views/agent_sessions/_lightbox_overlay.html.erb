<%# The full-screen screenshot browser (lightbox_controller.js). Sits inside a `data-controller="lightbox"` element;
    triggers are buttons with data-lightbox-id (and, on the feed, data-lightbox-url for their own session). %>
<div data-lightbox-target="overlay" data-action="click->lightbox#backdrop touchstart->lightbox#touchstart touchend->lightbox#touchend"
     class="hidden fixed inset-0 z-50 flex flex-col items-center justify-center gap-3 bg-black/90 p-4" role="dialog" aria-label="Screenshots">
  <div class="flex w-full max-w-6xl items-center gap-3 text-sm text-white/80">
    <span data-lightbox-target="counter" class="font-mono"></span>
    <span data-lightbox-target="caption" class="truncate flex-1"></span>
    <a data-lightbox-target="original" target="_blank" class="link text-white/70">Original</a>
    <button type="button" data-action="lightbox#close" class="btn btn-ghost btn-sm text-white" aria-label="Close">
      <iconify-icon icon="lucide:x" height="20"></iconify-icon>
    </button>
  </div>
  <div class="flex w-full max-w-6xl flex-1 min-h-0 items-center gap-2">
    <button type="button" data-action="lightbox#previous" class="btn btn-circle btn-ghost text-white shrink-0" aria-label="Previous">
      <iconify-icon icon="lucide:chevron-left" height="28"></iconify-icon>
    </button>
    <img data-lightbox-target="image" class="mx-auto max-h-full max-w-full min-w-0 rounded object-contain" alt="">
    <button type="button" data-action="lightbox#next" class="btn btn-circle btn-ghost text-white shrink-0" aria-label="Next">
      <iconify-icon icon="lucide:chevron-right" height="28"></iconify-icon>
    </button>
  </div>
  <div class="text-xs text-white/50">← → to browse · Esc to close</div>
</div>
