<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>

  <body style="margin: 0; padding: 0; background-color: #f2f5f8; font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1e2328; -webkit-font-smoothing: antialiased;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f2f5f8; padding: 40px 0;">
      <tr>
        <td align="center">
          <table width="560" cellpadding="0" cellspacing="0" style="max-width: 560px; width: 100%;">
            <!-- Logo -->
            <tr>
              <td style="padding: 0 0 32px 0;">
                <% if attachments["logo.webp"].present? %>
                  <img src="<%= attachments["logo.webp"].url %>" alt="Canine" height="48" style="height: 48px; width: auto; display: block;">
                <% else %>
                  <span style="font-size: 20px; font-weight: 700; color: #1e2328; letter-spacing: -0.5px;">Canine</span>
                <% end %>
              </td>
            </tr>
            <!-- Content card -->
            <tr>
              <td style="background-color: #ffffff; border-radius: 4px; padding: 40px;">
                <%= yield %>
              </td>
            </tr>
            <% if @manageable %>
            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 24px 0 0 0;">
                <span style="font-size: 12px; color: #8b949e;"><%= link_to "Manage email notifications", email_preference_url, style: "color: #8b949e; text-decoration: underline;" %></span>
              </td>
            </tr>
            <% end %>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
