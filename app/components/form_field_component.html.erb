<%# Labels sit beside the field when the form has room for both, and stack on top when it doesn't (a modal, a
    sidebar, a phone). It's a container query, so it follows the width of wherever the field is placed, not the window. %>
<div class="@container">
  <div class="form-control grid grid-cols-1 @5xl:grid-cols-4 gap-y-2 @5xl:gap-y-0 @5xl:gap-x-10">
    <div class="col-span-1">
      <div class="label">
        <span class="font-bold"><%= @label %></span>
      </div>
      <% if @description %>
        <div class="label text-sm text-base-content/80"><%= @description %></div>
      <% end %>
    </div>
    <div class="col-span-3 flex items-center">
      <div class="w-full">
      <%= content %>
      </div>
    </div>
  </div>
</div>
