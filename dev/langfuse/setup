#!/usr/bin/env bash
# Creates dev/langfuse/.env (generated secrets, the project's API keys and a login) if it doesn't exist, and prints
# the three LANGFUSE_* lines to add to Canine's own .env. Then: docker compose up -d
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -f .env ]; then
  cat > .env <<EOF
# Local Langfuse secrets and API keys (generated by ./setup; git-ignored)
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=$(openssl rand -hex 32)
SALT=$(openssl rand -hex 32)
ENCRYPTION_KEY=$(openssl rand -hex 32)
POSTGRES_PASSWORD=$(openssl rand -hex 16)
DATABASE_URL=postgresql://postgres:\${POSTGRES_PASSWORD}@postgres:5432/postgres
CLICKHOUSE_PASSWORD=$(openssl rand -hex 16)
REDIS_AUTH=$(openssl rand -hex 16)
MINIO_ROOT_PASSWORD=$(openssl rand -hex 16)
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=\${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=\${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=\${MINIO_ROOT_PASSWORD}
LANGFUSE_INIT_ORG_ID=canine
LANGFUSE_INIT_ORG_NAME=Canine
LANGFUSE_INIT_PROJECT_ID=canine-agents
LANGFUSE_INIT_PROJECT_NAME=Canine agents
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-$(openssl rand -hex 16)
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-$(openssl rand -hex 16)
LANGFUSE_INIT_USER_EMAIL=dev@canine.local
LANGFUSE_INIT_USER_NAME=Canine dev
LANGFUSE_INIT_USER_PASSWORD=$(openssl rand -hex 12)
EOF
  echo "Created .env"
fi
echo "Add to Canine's .env:"
echo "LANGFUSE_HOST=http://localhost:3100"
sed -n 's/^LANGFUSE_INIT_PROJECT_PUBLIC_KEY=/LANGFUSE_PUBLIC_KEY=/p; s/^LANGFUSE_INIT_PROJECT_SECRET_KEY=/LANGFUSE_SECRET_KEY=/p' .env
