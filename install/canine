#!/bin/bash
# Manages a Canine install made by install.sh. Settings live in $CANINE_HOME/.env.
set -euo pipefail

CANINE_HOME="${CANINE_HOME:-$HOME/.canine}"
cd "$CANINE_HOME" 2> /dev/null || { echo "No Canine install found in $CANINE_HOME" >&2; exit 1; }

case "${1:-}" in
  start) docker compose up -d ;;
  stop) docker compose stop ;;
  restart) docker compose up -d --force-recreate web worker ;;
  status) docker compose ps ;;
  logs) shift; docker compose logs -f --tail 100 "$@" ;;
  # The installer is idempotent: it keeps .env and the database, refreshes the compose file and pulls new images
  upgrade) curl -sSL https://canine.sh/install.sh | bash ;;
  uninstall)
    read -r -p "This deletes Canine's database and $CANINE_HOME. Type 'delete' to continue: " answer
    [ "$answer" = "delete" ] || { echo "Aborted"; exit 1; }
    docker compose down --volumes --rmi all
    rm -rf "$CANINE_HOME"
    ;;
  *)
    echo "Usage: canine start | stop | restart | status | logs [service] | upgrade | uninstall"
    exit 1
    ;;
esac
